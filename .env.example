# ============ LiteRAG 配置示例 ============
# 复制为 .env 后按需修改。所有 key 均可留空：
#   - LLM_PROVIDER=mock 时不需要任何 key，即可端到端演示
#   - Embedding/Rerank 默认本地模型（首次运行自动从 hf-mirror 下载），也不需要 key

# ---------- LLM ----------
# mock        : 离线演示模式（抽取式回答，无需 key）
# openai      : 任意 OpenAI 兼容接口（DeepSeek / 智谱 / Qwen / 中转站）
LLM_PROVIDER=mock

# DeepSeek 示例:  BASE_URL=https://api.deepseek.com  MODEL=deepseek-chat
# 智谱示例:       BASE_URL=https://open.bigmodel.cn/api/paas/v4  MODEL=glm-4-flash
# Qwen 示例:      BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  MODEL=qwen-plus
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# ---------- Embedding ----------
# local       : 本地 sentence-transformers 模型（无需 key）
# siliconflow : SiliconFlow API（BAAI/bge-m3，免费额度，需要 key）
# hash        : 测试用确定性哈希向量（仅单测/调试）
EMBEDDING_PROVIDER=local
# 优先使用项目 models/ 目录下的本地模型（离线加载）；目录不存在时按 HuggingFace repo id 自动下载
# 全新机器先运行: python scripts/download_models.py
LOCAL_EMBEDDING_MODEL=models/bge-small-zh-v1.5
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ---------- Reranker ----------
# local       : 本地 CrossEncoder（无需 key，CPU 可跑）
# siliconflow : SiliconFlow API（BAAI/bge-reranker-v2-m3）
# none        : 关闭精排
RERANK_PROVIDER=local
LOCAL_RERANKER_MODEL=models/bge-reranker-base

# ---------- 检索参数 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80
VECTOR_TOP_K=10
BM25_TOP_K=10
RRF_K=60
CANDIDATE_K=20
FINAL_TOP_K=5

# ---------- 功能开关（1/0）----------
ENABLE_HYBRID=1
ENABLE_RERANK=1
ENABLE_QUERY_REWRITE=1
ENABLE_MULTI_QUERY=1
ENABLE_HYDE=0
# CRAG-lite：精排 Top1 置信分低于阈值时自动扩大候选纠正重查一次（仅 mode=full 生效）
ENABLE_CORRECTIVE=1
CORRECTIVE_THRESHOLD=0.35
# Parent-Child：小块检索、父块（章节全文，截断）生成，兼顾检索精度与上下文完整性
ENABLE_PARENT_CHILD=1
PARENT_MAX_CHARS=1200

# ---------- 模型下载镜像（国内网络建议保留）----------
HF_ENDPOINT=https://hf-mirror.com

# ---------- 认证 ----------
# JWT 签名密钥：生产环境务必改成随机长字符串
AUTH_SECRET=dev-secret-literag-change-in-prod

# ---------- 视觉识图（图片理解入库）----------
# 摄入时抽取文档内嵌图片→识图模型生成中文描述入库；三项留空=复用主 LLM（要求支持识图）
VISION_ENABLED=1
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_MAX_IMAGES=5
